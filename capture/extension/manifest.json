{
  "manifest_version": 2,
  "name": "LipScan",
  "version": "0.2.5",
  "description": "Developer tool: records a YouTube video's frames, sound and captions to a local program for lipsync analysis. Talks only to 127.0.0.1.",
  "browser_specific_settings": {
    "gecko": {
      "id": "lipscan@thriftshoppin",
      "strict_min_version": "140.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  },
  "permissions": ["*://*.youtube.com/*", "storage"],
  "background": { "scripts": ["background.js"], "persistent": true },
  "web_accessible_resources": ["trace-worklet.js"],
  "browser_action": {
    "default_title": "LipScan",
    "default_popup": "popup.html",
    "default_icon": { "48": "icons/icon-48.png", "96": "icons/icon-96.png" }
  },
  "icons": { "48": "icons/icon-48.png", "96": "icons/icon-96.png" }
}
