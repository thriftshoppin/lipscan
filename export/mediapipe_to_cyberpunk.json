  "_neutral": "MediaPipe's 'no expression' score; nothing to drive.",
  "tongueOut": "not produced by MediaPipe (ARKit has it); tongue tracks come from the audio model instead (retarget --tongue).",
  "lipGap": "lip geometry (the gap between the lips), recorded in performance.json for analysis; not a track by itself.",
  "mouthWidth": "lip geometry; the mouth's width is already in the stretch, pucker and funnel shapes."
 },
